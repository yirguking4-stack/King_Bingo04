# ---- Server ----
PORT=4000
NODE_ENV=development

# ---- Database ----
DATABASE_URL=postgres://kingbingo:kingbingo@localhost:5432/kingbingo

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=123456789:REPLACE_WITH_REAL_BOT_TOKEN
# Used to verify Telegram WebApp initData signature (same as bot token secret)

# ---- Auth ----
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# ---- Admin ----
# Telegram IDs allowed to access the admin panel (comma separated)
ADMIN_TELEGRAM_IDS=111111111,222222222

# Secret code for the admin panel login (make it LONG and random)
ADMIN_BOOTSTRAP_CODE=replace_with_a_long_random_admin_code
# Only needed once, to promote yourself from the Mini App. Set back to false afterwards.
ALLOW_ADMIN_BOOTSTRAP=false

# Optional: your Admin Panel (Vercel) https URL. Adds an "Open Admin Panel" button to the Telegram alerts.
ADMIN_PANEL_URL=https://your-admin.vercel.app

# ---- CORS ----
# Your Vercel URLs, comma separated, NO trailing slash. Empty = allow everything.
CORS_ORIGINS=https://your-miniapp.vercel.app,https://your-admin.vercel.app

# ---- Bot-to-backend internal calls ----
# Shared secret the bot presents (header: x-bot-secret) for server-to-server
# calls that come from verified Telegram Bot API updates, not the Mini App.
BOT_INTERNAL_SECRET=replace_with_another_long_random_string
