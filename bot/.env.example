TELEGRAM_BOT_TOKEN=123456789:REPLACE_WITH_REAL_BOT_TOKEN
MINI_APP_URL=https://your-domain.example.com
BACKEND_API_URL=http://localhost:4000

# Admin's Telegram username (without @) shown on the Support button
SUPPORT_USERNAME=your_admin_username

# Blue "Menu" button next to the message box:
#   commands (default) = shows the command list; /menu sends the picture menu
#   webapp             = do not touch it (keeps what BotFather has set)
MENU_BUTTON_MODE=commands
